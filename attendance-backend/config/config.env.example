# Copy this file to config.env for local development. Never commit config.env.
# On a host (Render etc.) set these as environment variables instead and
# set NODE_ENV=PRODUCTION.
PORT=4000
DB_URI=mongodb://127.0.0.1:27017/attendance
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRE=5d
COOKIE_EXPIRE=2

# Public OAuth client identifier. A client secret is not used by this app.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Comma-separated college accounts allowed to create teacher accounts on first sign-in.
TEACHER_EMAILS=teacher@nitjsr.ac.in

# Optional, test only: comma-separated Google accounts (e.g. Gmail) that may
# sign in as students without being on a class roster. Leave empty for
# production behaviour.
# TEST_STUDENT_EMAILS=tester1@gmail.com,tester2@gmail.com

# Browser origins allowed to call the API with cookies (comma separated in
# CLIENT_URLS). In development localhost:3000, 127.0.0.1:3000 and
# *.trycloudflare.com quick tunnels are always allowed. In production
# (NODE_ENV=PRODUCTION) ONLY these values are allowed, so set your frontend URL:
CLIENT_URL=http://localhost:3000
# CLIENT_URLS=https://your-own-frontend.vercel.app

# Check-in sessions (all optional; defaults shown)
# CHECKIN_WINDOW_MIN=6
# KEY_LIFETIME_SEC=15
# CHECKIN_PROFILE=mid     high | mid | low (low is loudest and reaches the back rows best, but some students may faintly hear it)
# MAX_WAVES=6
# TIMEZONE=Asia/Kolkata
# EVIDENCE_TTL_HOURS=48   (backstop; evidence is deleted when the check-in locks)

# Reviews, lock and retention (Phase 10; all optional, defaults shown)
# LOCK_HOUR=9               check-ins lock at 09:00 local the next morning
# AUDIT_RETENTION_DAYS=180  audit logs + query text
# DIGEST_HOUR=20            teacher evening digest email (local time)

# Email (Brevo HTTP API). Without these, emails are skipped and logged.
# BREVO_API_KEY=
# MAIL_FROM=verified-sender@example.com
# MAIL_FROM_NAME=Bio Attend
# APP_URL=https://capstone-7th-sem.vercel.app   (links in emails)

# Secret for POST /api/v1/jobs/run (GitHub Actions cron sends it as x-jobs-secret).
# JOBS_SECRET=

# Face service (AWS Rekognition, Phase 7). Region must support Face Liveness.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Pass marks (0-100)
# LIVENESS_THRESHOLD=80
# MATCH_THRESHOLD=90
# REVIEW_THRESHOLD=75
