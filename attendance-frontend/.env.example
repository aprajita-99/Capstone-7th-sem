# Copy to .env to use a non-default backend URL, then restart npm start.
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
REACT_APP_API_URL=http://localhost:4000/api/v1
# Face liveness (Phase 7): Cognito identity pool with guest access
REACT_APP_AWS_REGION=ap-south-1
REACT_APP_AWS_IDENTITY_POOL_ID=ap-south-1:your-identity-pool-id
